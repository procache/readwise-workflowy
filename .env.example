# Readwise API Configuration
# Get your token from: https://readwise.io/access_token
READWISE_API_TOKEN=your_readwise_token_here

# ==========================================
# For readwise_to_workflowy.py (Direct API)
# ==========================================

# Option 1: Use Bearer Token (OAuth 2.0) - Recommended
# Get from: https://beta.workflowy.com/api-reference/
WORKFLOWY_BEARER_TOKEN=your_workflowy_bearer_token_here

# Option 2: Use Session ID (Legacy method)
# You can extract this from your browser cookies after logging into Workflowy
# WORKFLOWY_SESSION_ID=your_workflowy_session_id_here

# Note: You only need to set ONE of the above Workflowy authentication methods

# ==========================================
# For readwise_to_workflowy_wfapi.py (wfapi library) - MORE RELIABLE
# ==========================================

# Workflowy username and password (for wfapi version)
WORKFLOWY_USERNAME=your_email@example.com
WORKFLOWY_PASSWORD=your_password
